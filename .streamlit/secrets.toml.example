# Template for Streamlit secrets — copy this file to `.streamlit/secrets.toml` for local
# development, or paste these key/value pairs into the Streamlit Cloud "Secrets" UI for
# deployed environments. Never commit the real `secrets.toml`.

# Met Office DataHub site-specific forecast API key (required for the ingest's Met Office sanity-check
# pull; the app itself doesn't break if missing — Open-Meteo is the canonical forecast source).
METOFFICE_API_KEY = "paste-your-met-office-jwt-here"

# ENTSO-E transparency platform key (legacy — not used by the current ingest pipeline since we
# switched to BMRS for GB market data, but leaving the slot here in case it's reinstated).
# ENTSOE_API_KEY = "paste-your-entsoe-uuid-here"

# Elexon BMRS API key (currently unused — BMRS public endpoints don't require auth — but reserved
# here for future endpoints that do).
# ELEXON_API_KEY = ""

# Optional: shared password gate. If set, the app will require this password before showing
# any dashboard content. Leave blank/unset to deploy a fully open app (e.g. behind Streamlit
# Cloud's native OIDC auth, which is the recommended approach for multi-client gating).
# app_password = "set-a-strong-password-here"

# ---------------------------------------------------------------------------------------------------------------
# RenewaBlox Atlas wrappers (app_client_atlas.py / app_investor_atlas.py)

# Optional: base URL used by "Copy link" inside each atlas (overrides the default in atlas/apps/<app>/config.json).
# ATLAS_PUBLIC_URL = "https://renewablox-investor-atlas-v2.streamlit.app/"
