# Secrets — must NEVER be committed
.env
.env.local
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
*.pyo
.python-version
.venv/
venv/

# Databases — exclude all by default, then explicitly include the two we ship:
#   data.sqlite      — full history, tracked via Git LFS (local training / ingest)
#   data_lite.sqlite — slim deploy DB, a NORMAL git file (Streamlit Cloud can't read LFS)
*.db
*.sqlite
*.sqlite3
!data.sqlite
!data_lite.sqlite

# Logs
logs/
*.log

# IDE / OS noise
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local dev server config (machine-specific absolute paths — not portable)
# Everything under .claude/ stays local except the shared project settings file.
.claude/*
!.claude/settings.json

# Eunice rebuild: source zips and regenerable data/parquet (see rebuild_bundle/REBUILD_KICKOFF.md)
rebuild/data/
rebuild/out/*.parquet
rebuild/out/*.joblib
rebuild_bundle/
